# systemd unit for a BODDOS node (Linux: HP, ZBook).
# Install:
#   sudo cp deploy/boddos.service /etc/systemd/system/boddos.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now boddos
# Edit User/WorkingDirectory/paths for your setup. Store secrets in the
# EnvironmentFile, not in this unit.

[Unit]
Description=BODDOS node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/boddos
EnvironmentFile=-/etc/boddos/boddos.env
ExecStart=/opt/boddos/.venv/bin/python -m boddos --config /etc/boddos/boddos.yaml
Restart=on-failure
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
